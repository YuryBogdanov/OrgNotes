{
  "id": "long-matters",
  "name": "Долгие дела",
  "version": "1.0.0",
  "description": "Дела, которые тянутся неделями: давность касания, последний статус, срок проверки, группы «Пора проверить», «Ждём», «В норме».",
  "author": "Panopticon",
  "api": "^1.17",
  "minAppVersion": "1.11.0",
  "main": "main.js",
  "permissions": [
    "index.read",
    "files.read",
    "files.edit",
    "index.touch"
  ],
  "contributes": {
    "commands": [
      {
        "id": "long-matters.nav",
        "title": "Навигатор: долгие дела",
        "keys": [
          "⌃⌘9"
        ],
        "synonyms": [
          "долгие дела",
          "проекты"
        ]
      },
      {
        "id": "long-matters.open",
        "title": "Долгие дела: открыть список",
        "synonyms": [
          "долгие дела",
          "давно не трогал",
          "касания",
          "проекты"
        ]
      },
      {
        "id": "long-matters.walk",
        "title": "Долгие дела: начать обход",
        "keys": [
          "⌃⌘O"
        ],
        "synonyms": [
          "обход",
          "долгие дела",
          "проверить",
          "weekly review"
        ]
      },
      {
        "id": "long-matters.walk.continue",
        "title": "Обход: Продолжаем",
        "keys": [
          "⌘1"
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.walk.wait",
        "title": "Обход: Ждём…",
        "keys": [
          "⌘2"
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.walk.seen",
        "title": "Обход: Осмотрено",
        "keys": [
          "⌘3"
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.walk.archive",
        "title": "Обход: В архив",
        "keys": [
          "⌘4"
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.walk.close",
        "title": "Обход: Закрыть",
        "keys": [
          "⌘5"
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.walk.next",
        "title": "Обход: Дальше без решения",
        "keys": [
          "⌘↩"
        ],
        "scope": "review",
        "synonyms": [
          "пропустить",
          "дальше"
        ]
      },
      {
        "id": "long-matters.walk.back",
        "title": "Обход: Назад",
        "keys": [
          "⌘["
        ],
        "scope": "review"
      },
      {
        "id": "long-matters.review",
        "title": "Проверить через…",
        "cardKey": "R",
        "synonyms": [
          "долгие дела",
          "срок проверки",
          "next_review"
        ]
      },
      {
        "id": "long-matters.wait",
        "title": "Ждём…",
        "cardKey": "W",
        "synonyms": [
          "долгие дела",
          "ожидание",
          "waiting_on"
        ]
      },
      {
        "id": "long-matters.unwait",
        "title": "Больше не ждём",
        "synonyms": [
          "долгие дела",
          "ожидание"
        ]
      },
      {
        "id": "long-matters.seen",
        "title": "Осмотрено",
        "cardKey": "O",
        "synonyms": [
          "долгие дела",
          "осмотрел",
          "касание"
        ]
      }
    ],
    "navSections": [
      {
        "id": "long-matters",
        "title": "Долгие дела",
        "icon": "M4 16.5V10M8 16.5V4M12 16.5V12M16 16.5V7",
        "key": "long-matters.nav"
      }
    ],
    "views": [
      {
        "id": "long-matters.list",
        "title": "Долгие дела",
        "icon": "M4 16.5V10M8 16.5V4M12 16.5V12M16 16.5V7"
      }
    ],
    "fileCards": [
      {
        "id": "long-matters.card",
        "title": "Долгие дела"
      }
    ],
    "settings": [
      {
        "section": "Долгие дела",
        "icon": "M4 16.5V10M8 16.5V4M12 16.5V12M16 16.5V7",
        "groups": [
          {
            "caption": "ИСТОЧНИКИ",
            "fields": [
              {
                "key": "sources",
                "type": "custom",
                "where": "folder",
                "label": "Где долгие дела",
                "default": [
                  {
                    "kind": "file",
                    "file": "Midterm.org",
                    "level": 1
                  },
                  {
                    "kind": "tag",
                    "tag": "long"
                  }
                ],
                "hint": "Файл — заголовки выбранного уровня; тег — любой заголовок со своим тегом (наследованный не считается)"
              }
            ]
          },
          {
            "caption": "ПРОВЕРКА",
            "fields": [
              {
                "key": "norm",
                "type": "choice",
                "look": "menu",
                "where": "folder",
                "label": "Норма проверки",
                "default": 14,
                "options": [
                  {
                    "value": 7,
                    "label": "7 дней"
                  },
                  {
                    "value": 10,
                    "label": "10 дней"
                  },
                  {
                    "value": 14,
                    "label": "14 дней"
                  },
                  {
                    "value": 21,
                    "label": "21 день"
                  },
                  {
                    "value": 30,
                    "label": "30 дней"
                  },
                  {
                    "value": 45,
                    "label": "45 дней"
                  },
                  {
                    "value": 60,
                    "label": "60 дней"
                  }
                ],
                "hint": "Срок проверки — касание плюс норма, если у дела нет :NEXT_REVIEW:"
              },
              {
                "key": "wait",
                "type": "choice",
                "look": "menu",
                "where": "folder",
                "label": "Статус ожидания",
                "default": "WAIT",
                "options": [
                  {
                    "value": "WAIT",
                    "label": "WAIT"
                  }
                ],
                "hint": "Его ставит «Ждём…»; «Больше не ждём» возвращает статус до него"
              },
              {
                "key": "backlog",
                "type": "custom",
                "where": "folder",
                "label": "Статусы бэклога",
                "default": [],
                "hint": "Дела в этих статусах не отслеживаются: не попадают в «Пора проверить», «Сегодня» и обход; в списке — свёрнутой группой «Бэклог»"
              }
            ]
          },
          {
            "caption": "«СЕГОДНЯ»",
            "fields": [
              {
                "key": "today",
                "type": "switch",
                "where": "local",
                "label": "Блок в «Сегодня»",
                "default": true,
                "hint": "До трёх дел, которые пора проверить"
              }
            ]
          }
        ]
      }
    ],
    "todayBlocks": [
      {
        "id": "long-matters.today",
        "title": "Долгие дела",
        "hint": "Добавляет плагин «Долгие дела»: дела, которые пора проверить"
      }
    ]
  }
}
