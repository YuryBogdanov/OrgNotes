{
  "id": "hello",
  "name": "Привет",
  "version": "1.0.0",
  "description": "Пример плагина: команды, раздел навигатора, вкладка, настройки, форма, выбор места и даты, разбор — только через API.",
  "author": "Panopticon",
  "api": "^1.14",
  "minAppVersion": "0.9.0",
  "main": "main.js",
  "defaultEnabled": false,
  "permissions": [
    "index.read",
    "files.edit"
  ],
  "contributes": {
    "commands": [
      {
        "id": "hello.greet",
        "title": "Привет: поздороваться",
        "keys": [
          "⌃⌘H"
        ],
        "synonyms": [
          "пример",
          "плагин"
        ]
      },
      {
        "id": "hello.board",
        "title": "Привет: доска",
        "synonyms": [
          "пример",
          "плагин"
        ]
      },
      {
        "id": "hello.newTask",
        "title": "Привет: новая задача…",
        "synonyms": [
          "пример",
          "форма"
        ]
      },
      {
        "id": "hello.review",
        "title": "Привет: разобрать задачи",
        "synonyms": [
          "пример",
          "разбор"
        ]
      },
      {
        "id": "hello.note",
        "title": "Привет: заметка…",
        "synonyms": [
          "пример",
          "форма"
        ]
      },
      {
        "id": "hello.about",
        "title": "Привет: о плагине",
        "synonyms": [
          "пример",
          "лист"
        ]
      },
      {
        "id": "hello.choose",
        "title": "Привет: открыть файл…",
        "synonyms": [
          "пример",
          "выбор"
        ]
      },
      {
        "id": "hello.status",
        "title": "Привет: статус первой задачи…",
        "synonyms": [
          "пример",
          "статус"
        ]
      },
      {
        "id": "hello.reviewDone",
        "title": "Разбор «Привет»: Выполнено",
        "keys": [
          "⌘1"
        ],
        "scope": "review"
      },
      {
        "id": "hello.reviewLater",
        "title": "Разбор «Привет»: Запланировать…",
        "keys": [
          "⌘2"
        ],
        "scope": "review"
      },
      {
        "id": "hello.review2",
        "title": "Привет: разбор с заметками",
        "synonyms": [
          "пример",
          "разбор"
        ]
      },
      {
        "id": "hello.reviewNote",
        "title": "Разбор «Привет»: Записать заметку",
        "keys": [
          "⌘↩"
        ],
        "scope": "review"
      },
      {
        "id": "hello.reviewNext",
        "title": "Разбор «Привет»: Следующая",
        "keys": [
          "⌘]"
        ],
        "scope": "review"
      },
      {
        "id": "hello.ownSheet",
        "title": "Привет: свой лист…",
        "synonyms": [
          "пример",
          "лист"
        ]
      },
      {
        "id": "hello.show",
        "title": "Навигатор: Привет",
        "keys": [
          "⌃⌘7"
        ]
      },
      {
        "id": "hello.inbox",
        "title": "Привет: про Inbox",
        "synonyms": [
          "пример",
          "inbox"
        ]
      },
      {
        "id": "hello.move",
        "title": "Привет: перенести первую задачу…",
        "synonyms": [
          "пример",
          "перенос"
        ]
      },
      {
        "id": "hello.reviewCal",
        "title": "Разбор «Привет»: календарь",
        "keys": [
          "⌘K"
        ],
        "scope": "review"
      }
    ],
    "navSections": [
      {
        "id": "hello",
        "title": "Привет",
        "icon": "M4 10.5c1.5 3 4 4.5 6 4.5s4.5-1.5 6-4.5M7 7.5h.01M13 7.5h.01",
        "key": "hello.show"
      }
    ],
    "views": [
      {
        "id": "hello.board",
        "title": "Доска",
        "icon": "M3.5 3.5h13v13h-13zM3.5 8h13M8 8v8.5",
        "toolbar": true
      }
    ],
    "fileCards": [
      {
        "id": "hello.card",
        "title": "Привет"
      }
    ],
    "settings": [
      {
        "section": "Привет",
        "groups": [
          {
            "caption": "ПРИВЕТСТВИЕ",
            "fields": [
              {
                "key": "greeting",
                "type": "text",
                "label": "Слово приветствия",
                "placeholder": "Привет",
                "where": "folder",
                "default": "Привет"
              },
              {
                "key": "count",
                "type": "switch",
                "label": "Считать открытые задачи",
                "where": "local",
                "default": true
              }
            ],
            "help": "Пример настроек плагина: поля описаны в манифесте, лист рисует приложение."
          }
        ]
      }
    ]
  }
}
