{
  "id": "quarter-goals",
  "name": "Цели квартала",
  "version": "1.0.0",
  "description": "Цели на квартал своих и команды: обзор, «Мои цели», новая цель, отметки, разбор на 1-1, отчёт и перенос квартала.",
  "author": "Panopticon",
  "api": "^1.4",
  "minAppVersion": "0.9.0",
  "main": "main.js",
  "permissions": [
    "index.read",
    "files.edit",
    "clipboard"
  ],
  "contributes": {
    "commands": [
      {
        "id": "quarter-goals.nav",
        "title": "Навигатор: цели",
        "keys": [
          "⌃⌘4"
        ],
        "synonyms": [
          "цели"
        ]
      },
      {
        "id": "quarter-goals.new",
        "title": "Новая цель…",
        "synonyms": [
          "цель",
          "квартал",
          "goal"
        ]
      },
      {
        "id": "quarter-goals.review",
        "title": "Разобрать цели…",
        "synonyms": [
          "разбор",
          "1-1",
          "цели",
          "отметки"
        ],
        "step": true
      },
      {
        "id": "quarter-goals.overview",
        "title": "Цели: обзор квартала",
        "synonyms": [
          "цели",
          "квартал"
        ]
      },
      {
        "id": "quarter-goals.add",
        "title": "Добавить цели…",
        "synonyms": [
          "цели",
          "источник",
          "тимлид"
        ]
      },
      {
        "id": "quarter-goals.mark",
        "title": "Разбор целей: Добавить отметку",
        "keys": [
          "⌘↩"
        ],
        "scope": "review"
      },
      {
        "id": "quarter-goals.done",
        "title": "Разбор целей: Цель достигнута",
        "keys": [
          "⌘1"
        ],
        "scope": "review"
      },
      {
        "id": "quarter-goals.shift",
        "title": "Разбор целей: Сдвинуть срок…",
        "keys": [
          "⌘2"
        ],
        "scope": "review"
      },
      {
        "id": "quarter-goals.back",
        "title": "Разбор целей: Назад",
        "keys": [
          "⌘["
        ],
        "scope": "review"
      },
      {
        "id": "quarter-goals.next",
        "title": "Разбор целей: Следующая",
        "keys": [
          "⌘]"
        ],
        "scope": "review"
      }
    ],
    "navSections": [
