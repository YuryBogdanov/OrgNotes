{
  "version": 1,
  "workflows": [
    {
      "name": "Задачи",
      "states": [
        { "name": "TODO", "color": "red" },
        { "name": "NEXT", "color": "blue" },
        { "name": "WAIT", "color": "orange" },
        { "name": "DONE", "done": true, "color": "green" },
        { "name": "CANCELLED", "done": true, "color": "gray" }
      ]
    },
    {
      "name": "Встречи",
      "states": [
        { "name": "MEETING", "color": "blue" },
        { "name": "FINISHED", "done": true, "color": "green" },
        { "name": "SKIPPED", "done": true, "color": "gray" }
      ]
    },
    {
      "name": "Цели на квартал",
      "states": [
        { "name": "BACKLOG", "color": "gray" },
        { "name": "ACTIVE", "color": "blue" },
        { "name": "COMPLETED", "done": true, "color": "green" }
      ]
    }
  ]
}
